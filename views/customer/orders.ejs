<%- include("../partials/header", { pageTitle }) %>
<main class="customer-orders-page container">
  <div class="customer-orders-heading">
    <span class="eyebrow">FLORASEED · GÓC CỦA BẠN</span>
    <h1>Đơn hàng của tôi</h1>
    <p>Theo dõi những hạt giống bạn đã chọn và hành trình giao đến khu vườn.</p>
  </div>

  <% if (notice) { %><div class="admin-notice" role="status"><%= notice %></div><% } %>

  <% if (orders.length) { %>
    <div class="customer-order-list">
      <% orders.forEach((order) => { %>
        <article class="customer-order-card">
          <div class="customer-order-top">
            <div>
              <span class="eyebrow">MÃ ĐƠN HÀNG</span>
              <h2><%= order.order_code || `#${order.id}` %></h2>
              <time datetime="<%= order.created_at %>"><%= order.displayDate %></time>
            </div>
            <span class="customer-order-status"><%= order.displayStatus %></span>
          </div>
          <div class="customer-order-items">
            <% if (order.items.length) { %>
              <% order.items.forEach((item) => { %>
                <div class="customer-order-item">
                  <span><%= item.name || item.product_name || "Sản phẩm" %> × <%= item.quantity %></span>
                  <strong><%= Number(item.subtotal ?? (item.unitPrice ?? item.unit_price ?? 0) * item.quantity).toLocaleString("vi-VN") %>đ</strong>
                </div>
              <% }) %>
            <% } else { %>
              <p class="customer-orders-empty-items">Chi tiết sản phẩm của đơn hàng cũ không còn khả dụng.</p>
            <% } %>
          </div>
          <div class="customer-order-bottom">
            <span>Người nhận: <strong><%= order.customer_name %></strong> · <%= order.phone %></span>
            <span>Tổng cộng <strong><%= Number(order.total_price).toLocaleString("vi-VN") %>đ</strong></span>
          </div>
          <p class="customer-order-address"><%= order.address %></p>
          <% if (order.status === "pending") { %>
            <details class="customer-order-edit">
              <summary>Chỉnh sửa đơn hàng</summary>
              <form class="customer-order-edit-form" action="/customer/orders/<%= order.id %>/update" method="post">
                <div class="customer-order-recipient-fields">
                  <label>Người nhận
                    <input name="customer_name" value="<%= order.customer_name %>" required minlength="2" maxlength="100">
                  </label>
                  <label>Số điện thoại (10 chữ số)
                    <input name="phone" type="tel" inputmode="numeric" pattern="[0-9]{10}" minlength="10" maxlength="10" value="<%= order.phone %>" required>
                  </label>
                  <label>Địa chỉ nhận hàng
                    <textarea name="address" required minlength="8" maxlength="300" rows="2"><%= order.address %></textarea>
                  </label>
                </div>
                <h3>Sản phẩm và số lượng</h3>
                <div class="customer-order-edit-products">
                  <% products.forEach((product) => { %>
                    <label class="customer-order-edit-product">
                      <span><%= product.name %><small><%= Number(product.price).toLocaleString("vi-VN") %>đ · Có thể đặt tối đa <%= product.stock + (order.itemQuantities[product.id] || 0) %></small></span>
                      <input name="quantity_<%= product.id %>" type="number" min="0" max="99" step="1" value="<%= order.itemQuantities[product.id] || 0 %>" aria-label="Số lượng <%= product.name %>">
                    </label>
                  <% }) %>
                </div>
                <p class="customer-order-edit-hint">Nhập 0 để bỏ sản phẩm khỏi đơn. Chọn số lượng ít nhất 1 sản phẩm.</p>
                <button class="button button-primary" type="submit">Lưu thay đổi <span>✓</span></button>
              </form>
            </details>
            <form class="customer-order-cancel-form" action="/customer/orders/<%= order.id %>/cancel" method="post" onsubmit="return confirm('Bạn có chắc muốn hủy đơn hàng này? Số lượng sẽ được hoàn lại kho.')">
              <button class="customer-order-cancel-button" type="submit">Hủy đơn hàng</button>
            </form>
          <% } %>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <section class="customer-orders-empty">
      <span aria-hidden="true">✿</span>
      <h2>Bạn chưa có đơn hàng nào</h2>
      <p>Chọn những hạt giống yêu thích và đơn hàng sẽ được lưu tại đây.</p>
      <a class="button button-primary" href="/#products">Khám phá hạt giống <span>→</span></a>
    </section>
  <% } %>
</main>
<%- include("../partials/footer") %>